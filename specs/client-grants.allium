-- allium: 3
--
-- Vera Conecta — autorización de clientes MCP
--
-- Qué garantiza esta spec: que cada aplicación remota tiene su propia
-- identidad y sus propios alcances frente a una instalación, que la persona
-- propietaria puede retirarlos en cualquier momento, y que retirar uno no
-- toca a los demás.
--
-- Incluye:
--   - alta de un cliente autorizado por instalación;
--   - concesión de alcances y evidencia de consentimiento;
--   - emisión de la credencial de acceso, su vencimiento y su refresco;
--   - revocación por cliente y revocación en cascada al revocar la instalación;
--   - obligación de traducción de alcance remoto a permiso Vera local.
--
-- Alcance del piloto: lectura y escritura desde el primer día. No hay fase
-- intermedia de sólo lectura; lo que limita a un cliente son sus alcances
-- concedidos, no el calendario del proyecto.
--
-- Excluye:
--   - emparejamiento y canal de enlace (ver installation-link.allium);
--   - comprobación de alcance por solicitud (ver mcp-relay.allium);
--   - retención y borrado de este estado (ver privacy-and-audit.allium);
--   - el flujo OAuth 2.1 en sí, que es una integración estándar y debería
--     vivir en una spec de biblioteca aparte cuando se decida el proveedor.
--
-- Depende de:
--   - installation-link.allium para la identidad de la instalación y para el
--     hecho de que en el relay no existe identidad de persona propietaria;
--   - Vera local, que es la autoridad final de permisos: los alcances de esta
--     spec son un techo, nunca una concesión efectiva.
--
-- De la ausencia de identidad de persona se sigue algo que conviene decir sin
-- rodeos: autorizar y revocar dependen del canal Desktop <-> relay. Con Vera
-- Desktop apagada no existe ninguna vía alternativa de control; la decisión
-- espera a que Desktop vuelva.

use "./installation-link.allium" as enlace

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity CredencialVeraLocal {
    -- Vive en Vera Desktop y nunca llega al relay. Aparece aquí sólo como
    -- frontera: es lo que el conector selecciona para atribuir una operación.
    referencia_local: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract TraduccionDeAlcance {
    -- Obligación del conector de Vera Desktop al convertir una identidad
    -- remota en una credencial Vera local.
    credencial_para: (principal_id: String, alcances: Set<Alcance>) -> CredencialVeraLocal

    @invariant AlcanceNoSeAmplia
        -- La credencial Vera local resultante tiene alcance igual o menor al
        -- concedido en el relay. Nunca mayor, ni siquiera si Vera local
        -- dispone de una credencial más amplia para la misma persona.

    @invariant CredencialNoPropuestaPorElPayload
        -- La asociación remoto -> credencial local vive en Desktop. Ningún
        -- campo de la solicitud puede elegir participante ni credencial.

    @invariant BorradoSoloDeLoPropio
        -- El alcance delete faculta a un cliente para borrar o deshacer
        -- únicamente el contenido que él mismo creó, identificado por su
        -- originId. Nunca contenido de otro cliente ni contenido escrito por
        -- la persona. La comprobación es de Vera local; el relay sólo
        -- transporta la identidad con la que se hizo.

    @guidance
        -- Si no existe una credencial local de alcance suficientemente
        -- estrecho, la respuesta correcta es negar la operación, no promover
        -- la identidad remota a una credencial más amplia.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Alcance {
    -- Alcances de producto del piloto, cerrados por el dueño del producto.
    -- read: leer el grafo dentro de lo que Vera local permita.
    -- write: crear y editar contenido atribuido a este cliente.
    -- delete: borrar o deshacer únicamente el contenido que este mismo cliente
    --   creó, rastreado por originId. Nunca contenido de otros clientes ni de
    --   la persona; ver el contrato TraduccionDeAlcance.
    read | write | delete
}

enum EvidenciaDeConsentimiento {
    -- bearer_del_piloto: la persona generó manualmente el bearer desde Vera
    --   Desktop para ese cliente concreto. La prueba de consentimiento es ese
    --   acto local y explícito, no un flujo remoto: nadie puede obtener una
    --   credencial sin que la persona la haya emitido delante de su equipo.
    bearer_del_piloto
    | confirmacion_en_desktop
    | oauth_con_consentimiento_explicito
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity ClienteAutorizado {
    -- Una identidad por aplicación o dispositivo remoto. Revocar Claude no
    -- desconecta ChatGPT porque son dos instancias distintas de esta entidad,
    -- y por lo mismo el mismo producto en dos equipos son dos clientes.
    instalacion: enlace/Instalacion
    principal_id: String
    -- Etiqueta que elige la persona ("Claude en mi laptop"). Es dato de
    -- control admitido y persistible; ver privacy-and-audit.allium.
    etiqueta_de_aplicacion: String
    estado: pendiente | autorizado | credencial_vencida | revocado | expirado
    creado_en: Timestamp

    -- Vencimiento de la credencial de acceso: corto y renovable.
    expira_en: Timestamp when estado = pendiente | autorizado
    hash_de_credencial: String when estado = autorizado
    -- Ventana de refresco: larga, y es la que decide cuándo termina de verdad
    -- el acceso de una aplicación que nadie revocó.
    hash_de_refresco: String when estado = autorizado | credencial_vencida
    refresco_expira_en: Timestamp when estado = autorizado | credencial_vencida
    revocado_en: Timestamp when estado = revocado

    concesion: Concesion with cliente = this

    transitions estado {
        pendiente -> autorizado
        pendiente -> revocado
        pendiente -> expirado
        autorizado -> credencial_vencida
        autorizado -> revocado
        autorizado -> expirado
        credencial_vencida -> autorizado
        credencial_vencida -> revocado
        credencial_vencida -> expirado
        terminal: revocado, expirado
    }
}

entity Concesion {
    -- Alcances y vigencia otorgados a un cliente.
    cliente: ClienteAutorizado
    alcances: Set<Alcance>
    otorgada_en: Timestamp
    evidencia: EvidenciaDeConsentimiento
    estado: vigente | retirada
    retirada_en: Timestamp when estado = retirada

    permite(a): a in alcances

    transitions estado {
        vigente -> retirada
        terminal: retirada
    }

    invariant ConcesionVigenteConAlcances {
        -- Una concesión vigente sin alcances autorizaría sin conceder nada.
        estado = vigente implies alcances.count > 0
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Duraciones del piloto, decididas por el dueño del producto.
    vigencia_de_autorizacion_pendiente: Duration = 10.minutes
    vigencia_de_credencial_de_acceso: Duration = 1.hour
    ventana_de_refresco: Duration = 90.days
    bits_de_entropia_credencial: Integer = 256
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Autorizar --------------------------------------------------------------

rule AutorizarCliente {
    when: DesktopAutorizaCliente(instalacion, etiqueta_de_aplicacion, alcances, evidencia)
    requires: instalacion.estado in {conectada, desconectada}
    requires: alcances.count > 0
    ensures:
        let cliente = ClienteAutorizado.created(
            instalacion: instalacion,
            principal_id: identificador_opaco(config.bits_de_entropia_credencial),
            etiqueta_de_aplicacion: etiqueta_de_aplicacion,
            estado: pendiente,
            creado_en: now,
            expira_en: now + config.vigencia_de_autorizacion_pendiente
        )
        Concesion.created(
            cliente: cliente,
            alcances: alcances,
            otorgada_en: now,
            evidencia: evidencia,
            estado: vigente
        )
        ClienteAutorizadoCreado(instalacion: instalacion, cliente: cliente)
}

rule EmitirCredencialDeCliente {
    when: ClienteReclamaCredencial(cliente, prueba_de_consentimiento)
    requires: cliente.estado = pendiente
    requires: cliente.expira_en > now
    requires: verifica(prueba_de_consentimiento, cliente.principal_id)
    ensures:
        cliente.estado = autorizado
        cliente.hash_de_credencial = hash(secreto_nuevo(config.bits_de_entropia_credencial))
        cliente.expira_en = now + config.vigencia_de_credencial_de_acceso
        cliente.hash_de_refresco = hash(secreto_nuevo(config.bits_de_entropia_credencial))
        cliente.refresco_expira_en = now + config.ventana_de_refresco
        CredencialDeClienteEmitida(cliente: cliente)

    @guidance
        -- Se entregan dos credenciales de una vez: una de acceso, corta, y una
        -- de refresco, larga. Ambas se muestran una sola vez y sólo se
        -- conserva su hash con pepper operacional. El relay no puede
        -- reconstruirlas ni mostrarlas de nuevo: si se pierden, se autoriza
        -- otro cliente.
}

-- Refrescar ---------------------------------------------------------------

rule CredencialDeAccesoVence {
    -- Vencer no es perder el acceso: la aplicación conserva su concesión y
    -- puede volver a operar presentando la credencial de refresco.
    when: cliente: ClienteAutorizado.expira_en <= now
    requires: cliente.estado = autorizado
    ensures:
        cliente.estado = credencial_vencida
        cliente.expira_en = null
        cliente.hash_de_credencial = null
}

rule RefrescarCredencialDeCliente {
    when: ClienteRefrescaCredencial(cliente, prueba_de_refresco)
    requires: cliente.estado = credencial_vencida
    requires: cliente.refresco_expira_en > now
    requires: verifica(prueba_de_refresco, cliente.hash_de_refresco)
    ensures:
        cliente.estado = autorizado
        cliente.hash_de_credencial = hash(secreto_nuevo(config.bits_de_entropia_credencial))
        cliente.expira_en = now + config.vigencia_de_credencial_de_acceso
        CredencialDeClienteRefrescada(cliente: cliente)

    @guidance
        -- Refrescar no reabre el consentimiento ni amplía alcances: devuelve
        -- una credencial de acceso nueva para la concesión que ya existía. Un
        -- cliente revocado no refresca, porque revocar borra el hash de
        -- refresco en el acto.
}

-- Expirar ----------------------------------------------------------------

rule AutorizacionPendienteCaduca {
    when: cliente: ClienteAutorizado.expira_en <= now
    requires: cliente.estado = pendiente
    ensures:
        cliente.estado = expirado
        cliente.expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
}

rule CredencialDeClienteExpira {
    -- Fin real del acceso: se agotó la ventana de refresco sin que nadie la
    -- usara mientras la credencial de acceso seguía viva.
    when: cliente: ClienteAutorizado.refresco_expira_en <= now
    requires: cliente.estado = autorizado
    ensures:
        cliente.estado = expirado
        cliente.expira_en = null
        cliente.hash_de_credencial = null
        cliente.hash_de_refresco = null
        cliente.refresco_expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
        AccesoDeClienteTerminado(cliente: cliente, motivo: expiracion)
}

rule VentanaDeRefrescoSeAgota {
    when: cliente: ClienteAutorizado.refresco_expira_en <= now
    requires: cliente.estado = credencial_vencida
    ensures:
        cliente.estado = expirado
        cliente.hash_de_refresco = null
        cliente.refresco_expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
        AccesoDeClienteTerminado(cliente: cliente, motivo: expiracion)
}

-- Revocar ----------------------------------------------------------------

rule RevocarClientePendiente {
    when: DesktopRevocaCliente(cliente)
    requires: cliente.estado = pendiente
    ensures:
        cliente.estado = revocado
        cliente.revocado_en = now
        cliente.expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
        AccesoDeClienteTerminado(cliente: cliente, motivo: revocacion_de_la_persona)
}

rule RevocarClienteAutorizado {
    when: DesktopRevocaCliente(cliente)
    requires: cliente.estado = autorizado
    ensures:
        cliente.estado = revocado
        cliente.revocado_en = now
        cliente.expira_en = null
        cliente.hash_de_credencial = null
        cliente.hash_de_refresco = null
        cliente.refresco_expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
        AccesoDeClienteTerminado(cliente: cliente, motivo: revocacion_de_la_persona)

    @guidance
        -- Revocar es una operación de control, no de limpieza diferida: desde
        -- este instante la credencial deja de autenticar aunque el cliente la
        -- siga presentando y aunque el canal caiga un segundo después. Lo que
        -- sí exige la revocación es que Vera Desktop esté ahí para pedirla: no
        -- hay identidad de persona en el relay que pueda pedirla en su lugar.
}

rule RevocarClienteConCredencialVencida {
    -- Una aplicación cuya credencial de acceso venció sigue pudiendo
    -- refrescar: retirarle el acceso debe ser posible sin esperar a que lo
    -- haga.
    when: DesktopRevocaCliente(cliente)
    requires: cliente.estado = credencial_vencida
    ensures:
        cliente.estado = revocado
        cliente.revocado_en = now
        cliente.hash_de_refresco = null
        cliente.refresco_expira_en = null
        cliente.concesion.estado = retirada
        cliente.concesion.retirada_en = now
        AccesoDeClienteTerminado(cliente: cliente, motivo: revocacion_de_la_persona)
}

rule RevocarClientesPendientesAlRevocarInstalacion {
    when: enlace/InstalacionRevocada(inst, motivo)
    for cliente in ClientesAutorizados where estado = pendiente:
        requires: cliente.instalacion = inst
        requires: cliente.estado = pendiente
        ensures:
            cliente.estado = revocado
            cliente.revocado_en = now
            cliente.expira_en = null
            cliente.concesion.estado = retirada
            cliente.concesion.retirada_en = now
}

rule RevocarClientesAutorizadosAlRevocarInstalacion {
    when: enlace/InstalacionRevocada(inst, motivo)
    for cliente in ClientesAutorizados where estado = autorizado:
        requires: cliente.instalacion = inst
        requires: cliente.estado = autorizado
        ensures:
            cliente.estado = revocado
            cliente.revocado_en = now
            cliente.expira_en = null
            cliente.hash_de_credencial = null
            cliente.hash_de_refresco = null
            cliente.refresco_expira_en = null
            cliente.concesion.estado = retirada
            cliente.concesion.retirada_en = now
            AccesoDeClienteTerminado(cliente: cliente, motivo: instalacion_revocada)
}

rule RevocarClientesConCredencialVencidaAlRevocarInstalacion {
    when: enlace/InstalacionRevocada(inst, motivo)
    for cliente in ClientesAutorizados where estado = credencial_vencida:
        requires: cliente.instalacion = inst
        requires: cliente.estado = credencial_vencida
        ensures:
            cliente.estado = revocado
            cliente.revocado_en = now
            cliente.hash_de_refresco = null
            cliente.refresco_expira_en = null
            cliente.concesion.estado = retirada
            cliente.concesion.retirada_en = now
            AccesoDeClienteTerminado(cliente: cliente, motivo: instalacion_revocada)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ConcesionSigueAlCliente {
    -- Un cliente que ya no accede no conserva una concesión vigente.
    for c in Concesiones:
        c.cliente.estado in {revocado, expirado} implies c.estado = retirada
}

invariant ConcesionUnicaPorCliente {
    -- Un cliente tiene una concesión y no una acumulación de alcances
    -- concedidos en momentos distintos.
    for a in Concesiones:
        for b in Concesiones:
            a != b implies a.cliente != b.cliente
}

invariant CredencialSoloMientrasAutoriza {
    -- Sólo un cliente autorizado tiene un hash de credencial de acceso
    -- almacenado. Vencida la credencial, no queda nada con qué operar.
    for c in ClientesAutorizados:
        c.estado = autorizado implies c.hash_de_credencial != null
}

invariant RefrescoSoloMientrasHayConcesion {
    -- Un cliente que conserva credencial de refresco conserva su concesión
    -- vigente: refrescar nunca revive un acceso ya retirado.
    for c in ClientesAutorizados:
        c.estado in {autorizado, credencial_vencida} implies c.concesion.estado = vigente
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor ConectorDesktop {
    identified_by: enlace/Instalacion where estado in {conectada, desconectada}
}

actor ClienteMcp {
    identified_by: ClienteAutorizado where estado in {pendiente, autorizado, credencial_vencida}
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ConsentimientoYClientes {
    -- Lo que la persona propietaria decide sobre quién accede a su Vera. En
    -- el piloto lo presenta Vera Desktop.
    facing conector: ConectorDesktop

    let clientes = ClientesAutorizados where instalacion = conector

    exposes:
        for cliente in clientes:
            cliente.etiqueta_de_aplicacion
            cliente.estado
            cliente.creado_en
            cliente.concesion.alcances
            cliente.concesion.evidencia

    provides:
        DesktopAutorizaCliente(conector, etiqueta_de_aplicacion, alcances, evidencia)

    related:
        for cliente in clientes:
            ControlDeClienteAutorizado(cliente)

    @guarantee RevocarUnoNoAfectaAOtros
        -- Retirar el acceso de una aplicación no interrumpe el enlace de la
        -- instalación ni el acceso de las demás aplicaciones autorizadas.
        -- Retirar todas las autorizaciones es exactamente eso: retirarlas una
        -- por una desde aquí. Es una acción distinta de regenerar el
        -- identificador público, que no revoca nada.

    @guarantee LaCredencialNoSeMuestraDosVeces
        -- Esta superficie nunca expone la credencial de un cliente ya
        -- emitido, sólo su estado y sus alcances.

    @guarantee ControlSoloConDesktopPresente
        -- Autorizar y revocar exigen a Vera Desktop, que es el único principal
        -- autenticado del canal de control. En el relay no hay identidad de
        -- persona (ver installation-link.allium): con Desktop apagada no queda
        -- ninguna vía alternativa y la decisión espera a que Desktop vuelva.

    @guarantee LaEtiquetaEsDeLaPersona
        -- La etiqueta de aplicación la elige la persona y se conserva como
        -- dato de control. Sirve para que reconozca qué está autorizando; no
        -- se deriva del contenido ni del tráfico del cliente.
}

surface ControlDeClienteAutorizado {
    -- Una aplicación concreta, vista desde el control de la persona.
    context cliente: ClienteAutorizado
        where estado in {pendiente, autorizado, credencial_vencida}

    exposes:
        cliente.etiqueta_de_aplicacion
        cliente.estado
        cliente.expira_en when cliente.estado in {pendiente, autorizado}
        cliente.refresco_expira_en
            when cliente.estado in {autorizado, credencial_vencida}
        cliente.concesion.alcances
        cliente.concesion.evidencia

    provides:
        DesktopRevocaCliente(cliente)

    @guarantee RevocacionInmediata
        -- Tras revocar, ninguna solicitud nueva de ese cliente se autentica,
        -- aunque presente una credencial que todavía no ha expirado y aunque
        -- conserve la de refresco.

    timeout:
        CredencialDeClienteExpira
}

surface ReclamoDeCredencial {
    facing cliente: ClienteMcp

    exposes:
        cliente.etiqueta_de_aplicacion
        cliente.concesion.alcances
        cliente.estado

    provides:
        ClienteReclamaCredencial(cliente, prueba_de_consentimiento)
            when cliente.estado = pendiente
        ClienteRefrescaCredencial(cliente, prueba_de_refresco)
            when cliente.estado = credencial_vencida

    @guarantee ConsentimientoAntesQueCredencial
        -- No se emite credencial sin evidencia de consentimiento registrada
        -- en la concesión. En el piloto esa evidencia es bearer_del_piloto:
        -- la persona generó manualmente el bearer desde Vera Desktop para este
        -- cliente. El consentimiento es ese acto local y explícito; el relay
        -- no lo simula ni lo infiere de un flujo remoto.

    @guarantee RefrescarNoAmpliaNada
        -- Refrescar devuelve una credencial de acceso para la concesión que ya
        -- existe: mismos alcances, misma instalación, misma evidencia. Nunca
        -- es una segunda autorización.

    timeout:
        AutorizacionPendienteCaduca
}

surface TraduccionDeIdentidadRemota {
    -- Frontera con Vera local: el relay entrega una identidad derivada y el
    -- conector decide con qué credencial Vera opera.
    facing conector: ConectorDesktop

    exposes:
        conector.id_publico
        CredencialVeraLocal

    contracts:
        demands TraduccionDeAlcance

    @guarantee AutoridadFinalEnVera
        -- Los alcances de esta spec son un techo. Vera local puede conceder
        -- menos; jamás más.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "¿La credencial de refresco rota en cada uso, o vive los 90 días completos sin cambiar? La duración está decidida; la rotación no, y OAuth 2.1 la exige para clientes públicos."
